rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for auth verification
    function isAuthenticated() {
      return request.auth != null;
    }

    // -------------------------------------------------------------
    // 1. Coleção Principal de Estado da Aplicação (Arena do Competidor)
    // Armazena as chaves de estado (usuarios, alunos, professores, turmas, 
    // noticias, videos, logoApp, themeKey, notificacoes, contratos, etc.)
    // -------------------------------------------------------------
    match /arena_state/{key} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 2. Coleção Legada de Compatibilidade
    // -------------------------------------------------------------
    match /arena_app/{document=**} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 3. Regras Específicas por Coleção / Entidade (Escalabilidade)
    // -------------------------------------------------------------
    match /usuarios/{userId} {
      allow read, write: if true;
    }

    match /alunos/{alunoId} {
      allow read, write: if true;
    }

    match /professores/{profId} {
      allow read, write: if true;
    }

    match /turmas/{turmaId} {
      allow read, write: if true;
    }

    match /noticias/{noticiaId} {
      allow read, write: if true;
    }

    match /videos/{videoId} {
      allow read, write: if true;
    }

    match /notificacoes/{notifId} {
      allow read, write: if true;
    }

    match /certificados/{certificadoId} {
      allow read, write: if true;
    }

    match /contratos/{contratoId} {
      allow read, write: if true;
    }

    match /contratos_aceites/{aceiteId} {
      allow read, write: if true;
    }

    match /patrocinios/{patrocinioId} {
      allow read, write: if true;
    }

    match /graduacoes/{graduacaoId} {
      allow read, write: if true;
    }

    match /checkins/{checkinId} {
      allow read, write: if true;
    }

    match /eventos/{eventoId} {
      allow read, write: if true;
    }

    match /configs/{configId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 4. Regra Global de Fallback
    // Garante que nenhum documento do sistema seja bloqueado por falta de permissão
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
